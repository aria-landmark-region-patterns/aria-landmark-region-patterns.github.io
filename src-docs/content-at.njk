                <li><a href="https://addons.mozilla.org/en-US/firefox/addon/skipto-js-for-firefox/">SkipTo.js for Firefox</a></li>
                <li><a href="https://addons.opera.com/en/extensions/details/skiptojs-for-opera/">SkipTo.js for Opera</a></li>
              </ul>

              <figure class="image">
                <img src="images/landmarks-skipto.png" alt="">
                <figcaption>Screen shot of SkipTo.js menu of major landmarks and Headings</figcaption>
              </figure>

            </section>
