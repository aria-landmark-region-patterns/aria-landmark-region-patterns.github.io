          <aside class="container first" aria-labelledby="visualize">
            <h2 id="visualize">Visualize Landmarks</h2>

            <div class="content">
               <p id="inst" class="inst">Visually outline the landmarks and/or headings on the page.</p>

               <div class="button ">
                <button class="btn btn-primary" type="button" onclick="showLandmarks(event)" aria-describedby="inst">Show Landmarks</button>
              </div>

               <div class="button">
                <button class="btn btn-primary" type="button" onclick="showHeadings(event)"  aria-describedby="inst">Show Headings</button>
              </div>

              <h3>Landmarks on Page</h3>

              <ul class="counts">
                <li>2 Complementary</li>
                <li>1 Contentinfo</li>
                <li>1 Banner</li>
                <li>1 Main</li>
                <li><span id="nav-count">#</span> Navigation</li>
                <li><span id="region-count">#</span> Region</li>
              </ul>

              <h3>Headings on Page</h3>

              <ul class="counts">
                <li><span id="h1-count"></span> Heading Level 1 (<code>h1</code>)</li>
                <li><span id="h2-count"></span> Heading Level 2 (<code>h2</code>)</li>
                <li><span id="h3-count"></span> Heading Level 3 (<code>h3</code>)</li>
              </ul>

            </div>
          </aside>

<script>
window.addEventListener('load', () => {

  function countElement(elem) {
    const elems = document.querySelectorAll(`${elem}`);
    return elems.length;
  }

  document.querySelector('#nav-count').textContent = countElement('nav');
  document.querySelector('#region-count').textContent = countElement('section[aria-label], section[aria-labelledby');

  document.querySelector('#h1-count').textContent = countElement('h1');
  document.querySelector('#h2-count').textContent = countElement('h2');
  document.querySelector('#h3-count').textContent = countElement('h3');


});
</script>
